{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "justfuckingusenuxt-com",
  "preview_urls": false,
  "workers_dev": false,
  "routes": [
    {
      "pattern": "justfuckingusenuxt.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./.output/public"
  },
}
